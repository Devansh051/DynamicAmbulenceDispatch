# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_HEALTH_CHECK_INTERVAL_MS=10000

# Google Identity Services (GIS) Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Phase 4: Google Maps JavaScript API Browser Key
# Restrict using HTTP referrers (e.g. http://localhost:5173/*)
# If left empty, application automatically operates in EMS Tactical Vector Radar mode
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

