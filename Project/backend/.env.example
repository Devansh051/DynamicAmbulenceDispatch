# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (Microsoft SQL Server)
# Set DB_SERVER to your SQL Server instance, e.g., localhost\\SQLEXPRESS or localhost:1433
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=DynamicAmbulanceDispatch

# Authentication:
# Set DB_USER and DB_PASSWORD for SQL Server Authentication
DB_USER=ems_user
DB_PASSWORD=replace_with_your_sql_login_password
DB_PORT=1433

# Encryption and SSL settings
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Phase 2: Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=2h
COOKIE_NAME=ems_session
COOKIE_SECRET=your_cookie_signing_secret_random
BCRYPT_ROUNDS=10

# Phase 2: Google Identity Services (GIS) Configuration
# Obtain this from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Account creation policy for unlinked Google identities: 'disabled' (default) or 'pending'
GOOGLE_SIGNUP_MODE=disabled

# Phase 4: Government of India data.gov.in NIN Health Facilities API
# Obtain API key from https://data.gov.in/ (My Account -> API Key)
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=nin-health-faclities-geo-code-and-additional-parameters-updated-till-last-month
DATA_GOV_SYNC_INTERVAL_DAYS=3
HOSPITAL_SYNC_ENABLED=true

# Phase 4: Google Maps Platform (Server-Side)
# Required APIs: Places API (New), Routes API, Geocoding API
# Restrict this key to backend server IP addresses
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SEARCH_RADIUS_METERS=15000
GOOGLE_MAPS_REGION=in

# Phase 5: live fleet digital twin. Redis is the live-state source of truth.
# Leave the simulator disabled outside an explicitly isolated development environment.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000
FLEET_REDIS_PREFIX=ems:fleet:v1
FLEET_HEARTBEAT_INTERVAL_MS=10000
FLEET_LOCATION_STALE_MS=45000
FLEET_OFFLINE_MS=90000
FLEET_SOCKET_BROADCAST_INTERVAL_MS=1000
FLEET_TELEMETRY_MAX_EVENTS_PER_MINUTE=120
FLEET_TELEMETRY_MAX_PAYLOAD_BYTES=16384
FLEET_PERSISTENCE_WORKER_ENABLED=false
FLEET_PERSISTENCE_BATCH_SIZE=100
FLEET_PERSISTENCE_SAMPLE_MS=30000
FLEET_PERSISTENCE_RETRY_LIMIT=5
FLEET_PERSISTENCE_QUEUE_MAX=10000
# Each real device has a distinct key and an authorized database ambulance ID.
TELEMETRY_DEVICES_JSON={}
# Example shape: {"device-name":{"key":"replace-with-random-secret","ambulance_id":1}}
# Crew user ID -> ambulance ID; unbound crew cannot view or advance incidents.
CREW_AMBULANCE_BINDINGS_JSON={}
FLEET_TELEMETRY_MAX_AGE_MS=300000
FLEET_TELEMETRY_FUTURE_SKEW_MS=15000
# Set a strong, distinct secret before accepting external simulator telemetry.
SIMULATOR_TELEMETRY_KEY=
SIMULATOR_ENABLED=false
SIMULATOR_VEHICLE_COUNT=3
SIMULATOR_UPDATE_INTERVAL_MS=3000
SIMULATOR_HEARTBEAT_INTERVAL_MS=10000
# patrol moves each virtual vehicle; stationary is useful for heartbeat/stale-state tests.
SIMULATOR_MODE=patrol
SIMULATOR_START_LATITUDE=12.9716
SIMULATOR_START_LONGITUDE=77.5946
SIMULATOR_MAX_VEHICLES=25
SIMULATOR_ALLOW_ACTIVE_ASSIGNMENTS=false
# Simulation identity must always match the incident; cross-assignment cannot be enabled.
FLEET_DISPATCH_REQUIRE_ONLINE=false
